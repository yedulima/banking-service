# Copie este arquivo para .env antes de usar o Docker Compose.
# Para executar o Quarkus localmente, exporte estas mesmas variaveis no terminal.

# Aplicacao Quarkus
QUARKUS_HTTP_PORT=8181
SITUACAO_CADASTRAL_API_URL=http://localhost:8181

# Conexao da aplicacao com o PostgreSQL
# No Docker, use o nome do servico. Localmente, altere para localhost.
QUARKUS_DATASOURCE_HOST=postgres-db
QUARKUS_DATASOURCE_PORT=5432
QUARKUS_DATASOURCE_DATABASE=agencia
QUARKUS_DATASOURCE_USERNAME=
QUARKUS_DATASOURCE_PASSWORD=

# Porta publicada pelo container PostgreSQL na maquina host
POSTGRES_PORT=5432
